# ---------------------------------------------------------------------------
# Ghost Space - environment template.  Copy to .env and fill in.
# NEVER commit a real .env: it is in .gitignore.
# ---------------------------------------------------------------------------

# --- required in production -------------------------------------------------
# Hosted Postgres. Neon hands out the short `postgres://` form; the app
# rewrites it to `postgresql+psycopg://` automatically. Serverless-safe:
# NullPool, no PostGIS required.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Shared secret for the X-Admin-Token header. Every mutating admin action
# (resolve barrier, Ghost Space override, demo reset, seed) requires it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-to-a-long-random-string

# Sign demo JWTs. Any long random value.
JWT_SECRET=change-me-too

# --- optional ---------------------------------------------------------------
ENVIRONMENT=production

# Barrier classification. Unset => the built-in deterministic HEURISTIC feature
# detector (honestly labelled "heuristic", not a learned model). Set this to
# forward photos to your own inference service instead.
# CV_ENDPOINT_URL=https://my-inference.example.com/classify
# CV_ENDPOINT_TOKEN=

# Release rule tuning.
GHOST_GRACE_MINUTES=10
GHOST_PROBABILITY_THRESHOLD=0.7
GHOST_RECLAIM_WINDOW_MINUTES=5

# Pin the demo day so seeded bookings and screenshots always match.
# Blank => the most recent weekday.
# GHOST_DEMO_DATE=2026-10-05

# --- local development only -------------------------------------------------
# Unset DATABASE_URL and the API boots on a zero-config SQLite file.
# AUTO_SEED=true
# MEDIA_ROOT=./media
# CORS_ORIGINS=http://localhost:5173