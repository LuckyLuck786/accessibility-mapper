{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix accessibility-mapper/frontend ci && npm --prefix accessibility-mapper/frontend run build",
  "outputDirectory": "accessibility-mapper/frontend/dist",
  "framework": null,
  "installCommand": "echo skipped",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": [
        "accessibility-mapper/backend/app/**/*.py",
        "accessibility-mapper/backend/app/db/**/*.py"
      ],
      "excludeFiles": [
        "accessibility-mapper/backend/tests/**",
        "accessibility-mapper/backend/data/**",
        "accessibility-mapper/backend/media/**",
        "accessibility-mapper/backend/.venv/**",
        "accessibility-mapper/frontend/**",
        "**/*.db",
        "**/*.db-wal",
        "**/*.db-shm",
        "**/__pycache__/**",
        "**/.pytest_cache/**",
        "docs/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}